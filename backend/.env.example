APP_NAME=Vsparkz
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# --- Local (default): SQLite ---
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# --- Production (Neon PostgreSQL): uncomment and paste from Neon dashboard ---
# DB_CONNECTION=pgsql
# DB_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Or separate vars:
# DB_HOST=ep-xxxxx.region.aws.neon.tech
# DB_PORT=5432
# DB_DATABASE=neondb
# DB_USERNAME=your-user
# DB_PASSWORD=your-password
# DB_SSLMODE=require

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
